{
  "name": "unplugin-import-external-cdn",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.5",
  "license": "MIT",
  "homepage": "https://github.com/YieldRay/unplugin-import-external-cdn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YieldRay/unplugin-import-external-cdn.git"
  },
  "bugs": {
    "url": "https://github.com/YieldRay/unplugin-import-external-cdn/issues"
  },
  "keywords": [
    "unplugin",
    "rollup",
    "vite",
    "esbuild",
    "webpack"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./esbuild": "./dist/esbuild.mjs",
    "./rolldown": "./dist/rolldown.mjs",
    "./rollup": "./dist/rollup.mjs",
    "./rspack": "./dist/rspack.mjs",
    "./vite": "./dist/vite.mjs",
    "./webpack": "./dist/webpack.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.mts",
        "./*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "esbuild": ">=0.25.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "dependencies": {
    "unplugin": "^2.3.11",
    "unplugin-utils": "^0.3.2"
  },
  "devDependencies": {
    "@rspack/core": "^1.7.12",
    "@sxzz/eslint-config": "^7.8.5",
    "@sxzz/prettier-config": "^2.3.2",
    "@types/node": "^25.9.5",
    "bumpp": "^11.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "rolldown": "^1.2.7",
    "rollup": "^4.63.1",
    "tsdown": "^0.21.10",
    "tsdown-preset-sxzz": "^0.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "webpack": "^5.110.3"
  },
  "prettier": "@sxzz/prettier-config"
}
